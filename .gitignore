# Node.js dependencies
node_modules/

# VS Code directory
## .vscode/

# Output directories
out/
dist/
lib/

# Built webview bundle (produced by `npm run build:webview`)
src/LandingPage/content/dist/

# Isolated extensions directory and profile used by the "Run Extension" launch config
.vscode-dev-extensions/
.vscode-dev-user-data/

# Logs
logs/
*.log

# Dependency directories for native modules
bin/
obj/

# Typescript cache
*.tsbuildinfo

# Coverage directory used by testing tools
coverage/

# MacOS system files
.DS_Store

# Windows system files
Thumbs.db

# Optional npm cache directory
.npm/

# Yarn cache directory
.yarn/

# dotenv environment variables files (if used for secrets)
.env
.env.local
.env.*.local

# VS Code extension packaging files
*.vsix
*.vscode-test

# Lock files from unsupported package managers
yarn.lock

# Optional build cache
.cache/
*.afphoto~lock~

# Coding-agent tooling. Local to this checkout, not part of the extension, and `.claude/skills/*`
# are symlinks to directories outside the repo - committing them would publish broken links.
.agents/
.claude/
.codex/
.impeccable/
skills-lock.json

# Working scratch from UI sessions: standalone HTML the design tooling serves, and dated
# worklogs. Durable decisions belong in DECISIONS.md, not in a file named after a day.
live-preview/
WORKLOG-*.md

# Generated by the `impeccable` design tooling and only meaningful to it: DESIGN.md and
# PRODUCT.md carry its own frontmatter schema, and design-agent.sh reads a brief out of the
# ignored `.impeccable/` directory, so committing it would ship a broken path.
DESIGN.md
PRODUCT.md
scripts/design-agent.sh

# Scratch screenshots taken while working on the page. Referenced by nothing.
board.png
board-*.png

# Playwright run output. Baselines under `e2e/__aria__` and `e2e/__screenshots__` ARE committed -
# they are the ground truth. These three are per-run artefacts and are not.
playwright-report/
blob-report/
test-results/

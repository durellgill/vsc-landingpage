{
  "name": "vsc-landingpage",
  "displayName": "Landingpage (Dev)",
  "description": "Welcome page with customizable project bookmarks. Personal fork of renebuehling/vsc-landingpage.",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "start",
    "welcome",
    "bookmarks",
    "projects",
    "workbench"
  ],
  "publisher": "local",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/atechaccount/vsc-landingpage"
  },
  "pricing": "Free",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vsc-landingpage.showWelcomePage",
        "title": "Show Landing Page"
      },
      {
        "command": "vsc-landingpage.reset",
        "title": "Reset/Delete Landingpage Contents"
      },
      {
        "command": "vsc-landingpage.reload",
        "title": "Reload Landingpage",
        "when": "activeWebviewPanelId == 'vsc-landingpage'"
      },
      {
        "command": "vsc-landingpage.cloneRepository",
        "title": "Landingpage: Clone Repository"
      },
      {
        "command": "vsc-landingpage.addToGroup",
        "title": "Add to Landingpage Group..."
      }
    ],
    "keybindings": [
      {
        "command": "vsc-landingpage.focusInput",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeWebviewPanelId == 'vsc-landingpage'"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "vsc-landingpage.reset",
          "when": "activeWebviewPanelId == 'vsc-landingpage'"
        },
        {
          "command": "vsc-landingpage.reload",
          "when": "activeWebviewPanelId == 'vsc-landingpage'"
        }
      ],
      "explorer/context": [
        {
          "command": "vsc-landingpage.addToGroup",
          "group": "navigation@100"
        }
      ],
      "editor/title/context": [
        {
          "command": "vsc-landingpage.addToGroup",
          "group": "1_landingpage"
        }
      ]
    },
    "commandPalette": [
      {
        "command": "vsc-landingpage.showWelcomePage",
        "when": "true"
      }
    ],
    "configuration": {
      "title": "Landingpage",
      "properties": {
        "vsc-landingpage.autoshowOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Open Landingpage automatically in empty windows."
        },
        "vsc-landingpage.maxRecentItems": {
          "type": "number",
          "default": 20,
          "minimum": 0,
          "description": "Maximum number of entries to show in the 'Recent' group. Set to 0 for no limit."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "build:css": "sass src/LandingPage/content/landingpage2.scss src/LandingPage/content/dist/landingpage2.css --no-source-map --style=compressed",
    "watch:css": "sass --watch src/LandingPage/content/landingpage2.scss src/LandingPage/content/dist/landingpage2.css --no-source-map",
    "build:webview": "webpack --config webpack.webview.config.js",
    "watch:webview": "webpack --config webpack.webview.config.js --watch",
    "compile": "npm run build:css && npm run build:webview && webpack",
    "watch": "node scripts/watch.mjs",
    "package": "npm run build:css && npm run build:webview && webpack --mode production --devtool hidden-source-map",
    "build": "npm run compile",
    "vsix": "npx -y @vscode/vsce package",
    "install-local": "node scripts/install-local.mjs",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^10.8.0",
    "raw-loader": "^4.0.2",
    "sass": "^1.83.1",
    "sass-loader": "^16.0.4",
    "ts-loader": "^9.5.1",
    "typescript": "^5.7.2",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "lucide-static": "^0.471.0",
    "preact": "^10.29.7",
    "svg-inline-loader": "^0.8.2"
  }
}

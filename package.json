{
  "name": "vsc-landingpage",
  "displayName": "Landing Page (Dev)",
  "description": "Welcome page with customizable project bookmarks. Personal fork of renebuehling/vsc-landingpage.",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "start",
    "welcome",
    "bookmarks",
    "projects",
    "workbench"
  ],
  "publisher": "local",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/atechaccount/vsc-landingpage"
  },
  "pricing": "Free",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vsc-landingpage.showWelcomePage",
        "title": "Show Landing Page"
      },
      {
        "command": "vsc-landingpage.reset",
        "title": "Reset/Delete Landing Page Contents"
      },
      {
        "command": "vsc-landingpage.reload",
        "title": "Reload Landing Page",
        "when": "activeWebviewPanelId == 'vsc-landingpage'"
      },
      {
        "command": "vsc-landingpage.refreshRecents",
        "title": "Landing Page: Refresh Recent",
        "when": "activeWebviewPanelId == 'vsc-landingpage'"
      },
      {
        "command": "vsc-landingpage.cloneRepository",
        "title": "Landing Page: Clone Repository"
      },
      {
        "command": "vsc-landingpage.addToGroup",
        "title": "\u2795 Add to Landing Page Group..."
      }
    ],
    "keybindings": [
      {
        "command": "vsc-landingpage.focusInput",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeWebviewPanelId == 'vsc-landingpage'"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "vsc-landingpage.reset",
          "when": "activeWebviewPanelId == 'vsc-landingpage'"
        },
        {
          "command": "vsc-landingpage.reload",
          "when": "activeWebviewPanelId == 'vsc-landingpage'"
        }
      ],
      "explorer/context": [
        {
          "command": "vsc-landingpage.addToGroup",
          "group": "navigation@100"
        }
      ],
      "editor/title/context": [
        {
          "command": "vsc-landingpage.addToGroup",
          "group": "1_landingpage"
        }
      ]
    },
    "commandPalette": [
      {
        "command": "vsc-landingpage.showWelcomePage",
        "when": "true"
      }
    ],
    "configuration": {
      "title": "Landing Page",
      "properties": {
        "vsc-landingpage.autoshowOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Open Landing Page automatically in empty windows."
        },
        "vsc-landingpage.maxRecentItems": {
          "type": "number",
          "default": 20,
          "minimum": 0,
          "description": "Maximum number of entries to show in the 'Recent' group. Set to 0 for no limit."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "build:webview": "vite build --config vite.config.webview.mts",
    "build:extension": "vite build --config vite.config.extension.mts",
    "build:harness": "vite build --config vite.config.harness.mts",
    "compile": "npm run build:webview && npm run build:extension",
    "watch": "node scripts/watch.mjs",
    "package": "npm run compile",
    "build": "npm run compile",
    "vsix": "npx -y @vscode/vsce package",
    "install-local": "node scripts/install-local.mjs",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "typecheck": "tsc -p . --noEmit",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "harness": "npm run compile && npm run build:harness && node scripts/harness.mjs"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^10.8.0",
    "sass": "^1.83.1",
    "typescript": "^5.7.2",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "lucide-static": "^0.471.0",
    "preact": "^10.29.7"
  }
}

{
  "name": "vsc-landingpage",
  "displayName": "Landing Page",
  "description": "A customizable VS Code start page for bookmark groups and recently opened files, folders, and workspaces.",
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "start",
    "welcome",
    "bookmarks",
    "projects",
    "workbench"
  ],
  "publisher": "local",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/atechaccount/vsc-landingpage"
  },
  "homepage": "https://github.com/atechaccount/vsc-landingpage#readme",
  "bugs": {
    "url": "https://github.com/atechaccount/vsc-landingpage/issues"
  },
  "pricing": "Free",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vsc-landingpage.showWelcomePage",
        "title": "Show Landing Page"
      },
      {
        "command": "vsc-landingpage.reset",
        "title": "Reset/Delete Landing Page Contents"
      },
      {
        "command": "vsc-landingpage.reload",
        "title": "Reload Landing Page",
        "when": "activeWebviewPanelId == 'vsc-landingpage'"
      },
      {
        "command": "vsc-landingpage.refreshRecents",
        "title": "Landing Page: Refresh Recent",
        "when": "activeWebviewPanelId == 'vsc-landingpage'"
      },
      {
        "command": "vsc-landingpage.cloneRepository",
        "title": "Landing Page: Clone Repository"
      },
      {
        "command": "vsc-landingpage.addToGroup",
        "title": "\u2795 Add to Landing Page Group..."
      }
    ],
    "keybindings": [
      {
        "command": "vsc-landingpage.focusInput",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeWebviewPanelId == 'vsc-landingpage'"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "vsc-landingpage.reset",
          "when": "activeWebviewPanelId == 'vsc-landingpage'"
        },
        {
          "command": "vsc-landingpage.reload",
          "when": "activeWebviewPanelId == 'vsc-landingpage'"
        }
      ],
      "explorer/context": [
        {
          "command": "vsc-landingpage.addToGroup",
          "group": "navigation@100"
        }
      ],
      "editor/title/context": [
        {
          "command": "vsc-landingpage.addToGroup",
          "group": "1_landingpage"
        }
      ]
    },
    "commandPalette": [
      {
        "command": "vsc-landingpage.showWelcomePage",
        "when": "true"
      }
    ],
    "configuration": {
      "title": "Landing Page",
      "properties": {
        "vsc-landingpage.autoshowOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Open Landing Page automatically in empty windows."
        },
        "vsc-landingpage.maxRecentItems": {
          "type": "number",
          "default": 20,
          "minimum": 0,
          "description": "Maximum number of entries to show in the 'Recent' group. Set to 0 for no limit."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "build:webview": "vite build --config vite.config.webview.mts",
    "build:extension": "vite build --config vite.config.extension.mts",
    "build:harness": "vite build --config vite.config.harness.mts",
    "compile": "npm run build:webview && npm run build:extension",
    "watch": "node scripts/watch.mjs",
    "package": "npm run compile",
    "build": "npm run compile",
    "vsix": "npx -y @vscode/vsce package",
    "install-local": "node scripts/install-local.mjs",
    "compile-tests": "node scripts/compile-tests.mjs",
    "watch-tests": "node scripts/compile-tests.mjs --watch",
    "typecheck": "npm run typecheck:src && npm run typecheck:scripts && npm run typecheck:e2e",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test --fail-zero",
    "harness": "npm run compile && npm run build:harness && node scripts/harness.mjs",
    "motion-check": "node scripts/motion-check.mjs",
    "fallow": "fallow",
    "fallow:audit": "fallow audit --base origin/main",
    "typecheck:src": "tsc -p . --noEmit",
    "typecheck:scripts": "tsc --noEmit --allowJs --checkJs --target es2022 --module nodenext --moduleResolution nodenext --skipLibCheck scripts/compile-tests.mjs scripts/motion-check.mjs",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:ui": "playwright test --ui",
    "typecheck:e2e": "tsc --noEmit --strict --target es2022 --module esnext --moduleResolution bundler --skipLibCheck --types node playwright.config.ts e2e/*.spec.ts",
    "test:e2e:docker": "docker run --rm --network host -v \"$PWD\":/w -w /w mcr.microsoft.com/playwright:v1.62.1-noble npx playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "1.125.0",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^10.8.0",
    "fallow": "^3.14.0",
    "sass": "^1.83.1",
    "typescript": "^5.7.2",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "lucide-static": "^0.471.0",
    "preact": "^10.29.7"
  }
}

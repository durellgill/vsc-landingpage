.vscode/**
.vscode-test/**
scripts/**
.vscode-dev-extensions/**
.vscode-dev-user-data/**
out/**
node_modules/**
src/**
.gitignore
.yarnrc
vite.config.*.mts
**/tsconfig.json
**/eslint.config.mjs
**/*.map
**/*.ts
**/.vscode-test.*
DEVELOP.md
DECISIONS.md

# Agent tooling. `.claude/skills/*` are symlinks *to directories*; vsce enumerates them as
# files and its secret scanner then read()s them, which fails with EISDIR and aborts the
# package. None of this belongs in a VSIX regardless.
.claude/**
.agents/**
.codex/**
.impeccable/**
skills-lock.json
.fallowrc.json
.fallow/**

# CI configuration. Runs on GitHub, means nothing inside an installed extension.
.github/**

# Vercel deployment configuration stays in Git but does not belong in the installed extension.
.env.local
.env.*.local
.vercel/**
.vercelignore
api/**
vercel.json

# Working scratch: standalone HTML the design tooling serves, dated worklogs, and the
# tool-generated design and product briefs. All of these are gitignored too - `.vscodeignore`
# does not inherit from `.gitignore`, so anything added there has to be added here as well or
# it silently ships.
live-preview/**
WORKLOG-*.md
DESIGN.md
PRODUCT.md

# Scratch screenshots taken while working on the page. Referenced by nothing.
board.png
screenshots/**

# Working notes for contributors and coding agents. README.md and CHANGELOG.md still ship,
# because the marketplace renders those; these files are internal and were only being packaged
# by accident.
AGENTS.md
CLAUDE.md
NOTES.md
TODO.md
IDEAS.md
HANDOFF.md

# Tooling state, not part of the extension.
paseo.json

# Upstream's demo GIFs, which were the whole size of the extension. Nothing embeds them - the
# readme only mentions the folder in passing - so shipping them cost 1.4 MB for no benefit.
doc/**

# Browser tests. Nothing here belongs in an installed extension.
e2e/**
playwright.config.ts
playwright-report/**
test-results/**
